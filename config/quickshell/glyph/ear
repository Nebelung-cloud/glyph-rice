#!/usr/bin/env python3
# наушники Nothing / CMF по их RFCOMM-протоколу (подсмотрен в Gadgetbridge: service/devices/nothing/NothingProtocol.java)
#   ear MAC          → {"mode": 4, "l": 100, "r": 95, "case": 80}  (case — только когда наушники в кейсе;
#                       у полноразмерных и шейных одно "bat"; без шумодава — Ear (open) — нет "mode")
#   ear MAC mode N   → поставить режим, ответ тот же
# режимы: 1 high, 2 mid, 3 low, 4 adaptive, 5 off, 7 transparency
import json, re, socket, struct, sys, uuid

CTRL = uuid.UUID("aeac4a03-dff5-498f-843a-34487cf133eb").bytes


# канал не постоянный у разных моделей — спросить SDP: у сервиса CTRL в списке протоколов RFCOMM (uuid16 0003) и номер
def channel(mac):
    q = b"\x35\x11\x1c" + CTRL + b"\xff\xff\x35\x03\x09\x00\x04\x00"
    with socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP) as s:
        s.settimeout(4)
        s.connect((mac, 1))
        s.send(struct.pack(">BHH", 6, 1, len(q)) + q)
        m = re.search(rb"\x19\x00\x03\x08(.)", s.recv(1024), re.S)
    if not m:
        sys.exit("not a Nothing device")
    return m[1][0]


def crc(b):  # CRC-16/MODBUS
    c = 0xFFFF
    for x in b:
        c ^= x
        for _ in range(8):
            c = c >> 1 ^ 0xA001 if c & 1 else c >> 1
    return c


# кадр: 55, control, команда, длина, номер, данные, crc. Ответ приходит с командой без бита 0x8000
def ask(s, reqs):
    for cmd, p in reqs:
        m = struct.pack("<BHHHB", 0x55, 0x120, cmd, len(p), 0) + p
        s.send(m + struct.pack("<H", crc(m)))
    want = {cmd & 0x7FFF for cmd, _ in reqs}
    got, buf = {}, b""
    while want - got.keys():
        try:
            d = s.recv(1024)
        except TimeoutError:  # модель без шумодава может не ответить на его запрос — отдать, что есть
            break
        if not d:  # наушники ушли посреди обмена — recv отдаёт b"" без конца, цикл крутился бы вечно
            sys.exit("closed")
        buf += d
        while buf and buf[0] != 0x55:
            buf = buf[1:]
        while len(buf) >= 8:
            ctl, cmd, n = struct.unpack_from("<HHH", buf, 1)
            size = 8 + n + (2 if ctl & 0x20 else 0)
            if len(buf) < size:
                break
            got[cmd & 0x7FFF] = buf[8 : 8 + n]
            buf = buf[size:]
    return got


mac, *rest = sys.argv[1:]
reqs = [(0xF00F, bytes([1, int(rest[1]), 0]))] if rest[:1] == ["mode"] else []
with socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM) as s:
    s.settimeout(4)
    s.connect((mac, channel(mac)))
    got = ask(s, reqs + [(0xC007, b""), (0xC01E, b"")])

# заряд: число батарей, дальше пары (2 левый, 3 правый, 4 кейс, 6 одна на всё; уровень & 7f). Режим: 01 MM 00 …
if 0x4007 not in got:
    sys.exit("no battery")
bat, out = got[0x4007], {}
if len(got.get(0x401E, b"")) > 1:
    out["mode"] = got[0x401E][1]
for i in range(bat[0]):
    k, v = bat[1 + 2 * i], bat[2 + 2 * i]
    out[{2: "l", 3: "r", 4: "case", 6: "bat"}.get(k, str(k))] = v & 0x7F
print(json.dumps(out))
